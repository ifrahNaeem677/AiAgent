# ---- Required: ONE of these keys ----
GROQ_API_KEY=gsk_...
# ANTHROPIC_API_KEY=sk-ant-...
# Force a provider (otherwise: Groq if only GROQ_API_KEY is set)
# LLM_PROVIDER=groq
# "auto" picks a current Groq model that supports tools
GROQ_MODEL=auto

# ---- Your store ----
STORE_NAME=Demo Store
SUPPORT_EMAIL=support@example.com

# ---- Model settings ----
# claude-opus-5-5 is the most capable; claude-haiku-5-5 is far cheaper for simple FAQ traffic.
AGENT_MODEL=claude-opus-5-5
# low | medium | high  (low is fast and cheap, fine for most support chats)
AGENT_EFFORT=low

# ---- Where order data comes from: mock | shopify | woocommerce ----
ORDER_BACKEND=mock

# Shopify (Step 3): Settings -> Apps -> Develop apps -> create app with read_orders scope
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_...

# WooCommerce (Step 3): WooCommerce -> Settings -> Advanced -> REST API -> Read key
WC_STORE_URL=https://your-store.com
WC_CONSUMER_KEY=ck_...
WC_CONSUMER_SECRET=cs_...

# ---- Hand-off to staff (Step 4): Slack incoming webhook, optional ----
ESCALATION_WEBHOOK_URL=

# ---- Websites allowed to embed the chat widget (comma separated) ----
ALLOWED_ORIGINS=http://localhost:8000
